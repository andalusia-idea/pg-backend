							"var resolveVariables = s => s.replace(/\\{\\{([^}]+)\\}\\}/g,  \r",
							"  (match, capture) => pm.variables.get(capture));\r",
							"\r",
							"var secret=pm.collectionVariables.get(\"secret\");\r",
							"var secretMD5=CryptoJS.MD5(secret).toString();\r",
							"\r",
							"var stringToSign=\"secret=\"+secretMD5+\"/APIKey=\"+resolveVariables(pm.request.headers.get('APIKey'))+\r",
							"\"/token=\"+pm.collectionVariables.get(\"access-token\");\r",
							"console.log(\"String to sign : \"+stringToSign);\r",
							"var sha256Res = CryptoJS.SHA256(stringToSign).toString(CryptoJS.enc.Hex);\r",
							"console.log(\"result sign : \"+sha256Res);\r",
							"\r",
							"pm.collectionVariables.set(\"request-auth\",sha256Res);\r",
