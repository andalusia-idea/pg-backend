# Application
APP_NAME=TRANSACTION
NODE_ENV=test
PORT=3003
VERSION=v1
TIMEZONE="Asia/Jakarta"
CORS_ORIGINS=http://localhost:3000/;https://api.example.com
TRUST_PROXY=

# Database PostgreSQL
POSTGRESQL_URL_MASTER="postgresql://postgres:12345678@localhost:5432/pgtest?TimeZone=Asia/Jakarta&schema=transaction"
POSTGRESQL_URL_SLAVE="postgresql://postgres:12345678@localhost:5432/pgtest?TimeZone=Asia/Jakarta&schema=transaction"

# TCP Auth
CLIENT_AUTH_NAME="AUTH_SERVICE"
CLIENT_AUTH_HOST="127.0.0.1"
CLIENT_AUTH_PORT=4001

# TCP Config
CLIENT_CONFIG_NAME="CONFIG_SERVICE"
CLIENT_CONFIG_HOST="127.0.0.1"
CLIENT_CONFIG_PORT=4002

# TCP Transaction
CLIENT_TRANSACTION_NAME="TRANSACTION_SERVICE"
CLIENT_TRANSACTION_HOST="127.0.0.1"
CLIENT_TRANSACTION_PORT=4003

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=redis
REDIS_PASSWORD=12345678

# Redis Auth
MERCHANT_SIGNATURE_TIMESTAMP_TOLERANCE_SECONDS=300
MERCHANT_SIGNATURE_NONCE_TTL_SECONDS=600
MERCHANT_SIGNATURE_SECRET_KEY_GRACE_SECONDS=86400
MERCHANT_SIGNATURE_CACHE_TTL_SECONDS=60
MERCHANT_SIGNATURE_RATE_LIMIT_MAX_REQUESTS=120
MERCHANT_SIGNATURE_RATE_LIMIT_WINDOW_SECONDS=60

# Redis Config
BASE_FEE_TTL_SECONDS=21600
MERCHANT_FEE_TTL_SECONDS=21600
AGENT_SHAREHOLDER_TTL_SECONDS=21600

# UPSTREAM:

## MOTIONPAY
# Empty = unrestricted. Set to Flash egress IPs/CIDRs before production - the
# callback has no signature, so this is its only authentication.
# Terminal/merchant identifier embedded in every QR. Flash merchant id or a
# POS identifier, max 21 chars. NOT per-transaction.
MOTIONPAY_MERCHANT_ID="00059102"
MOTIONPAY_CALLBACK_ALLOWED_IPS="127.0.0.1,::1"
# The uat-local fake, not the sandbox. The whole argument for the harness
# design is that this line is the only difference between the two, which is
# easier to believe when both are visible. Real sandbox:
#   MOTIONPAY_QRIS_BASE_URL="https://sandbox-app.flashmobile.id"
# `localhost` rather than `127.0.0.1` is safe here even though uat-local binds
# the IPv4 loopback only: Node's happy-eyeballs tries both families. The
# IP-literal requirement applies to the webhook URL stored on the merchant,
# where `@IsUrl()` refuses a TLD-less host.
MOTIONPAY_QRIS_BASE_URL="http://localhost:3010/motionpay"
MOTIONPAY_CLIENT_KEY="FM-9240-c32fced0e25be5016b77821f"
MOTIONPAY_SERVER_KEY="FMPA-84329b3851efa820b406bbdb3d0eb92b4820"
MOTIONPAY_TIMEOUT_MS=15000
MOTIONPAY_TOKEN_SKEW_SECONDS=300
# Transfer and Biller are NOT reachable in production - confirmed with
# MotionPay - so there is no uat-local fake for them and these stay pointed at
# the sandbox. Payouts route to Jatelindo. Nothing in the harness should reach
# these; if a run ever does, that is the finding.
MOTIONPAY_TRANSFER_BASE_URL="https://sandbox-secure.flashmobile.id"
MOTIONPAY_TRANSFER_CLIENT_KEY=""
MOTIONPAY_TRANSFER_SERVER_KEY=""
MOTIONPAY_BILLER_BASE_URL="https://sandbox-secure.flashmobile.id"

## JATELINDO
JATELINDO_TIMEOUT_MS=15000
JATELINDO_TOKEN_SKEW_SECONDS=300
JATELINDO_CALLBACK_ALLOWED_IPS="127.0.0.1,::1"

# The uat-local fake, not the provider's dev host. Repointed by build-order
# Step 8c. Real dev endpoint, kept visible because the whole argument for this
# harness is that one line is the difference between the two:
#   JATELINDO_TRANSFER_BASE_URL="https://dev-transferonline.fello.id:14890"
#
# `localhost` rather than `127.0.0.1` for the reason the MOTIONPAY line above
# gives. Note the fake's controller prefix has to reproduce the path this base
# URL is joined with - `/Host/Transfer/...` from JATELINDO_ENDPOINT, capitals
# included - so changing either one without the other is a 404 that reads as
# the provider being down.
JATELINDO_TRANSFER_BASE_URL="http://localhost:3010/jatelindo"
JATELINDO_TRANSFER_USERNAME="devids"
JATELINDO_TRANSFER_PASSWORD="dlijlk125"
JATELINDO_TRANSFER_API_KEY="534715a1-348e-11ee-80e3-00259064666c"
JATELINDO_TRANSFER_SECRET="uihjbmn1281AS8sh1"
