generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  previewFeatures     = ["typedSql"]
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
  schemas  = ["transaction"]
}

model PurchaseTransaction {
  id         Int @id @default(autoincrement())
  merchantId Int

  systemReference   String  @unique // Our System Reference No
  // partnerReferenceNo (SNAP). Unique PER MERCHANT, not globally: merchants
  // number their own orders, so a global unique would let the first merchant to
  // use "ORDER-001" permanently block every other merchant from that string.
  merchantReference String
  // referenceNo (SNAP). Nullable because we do not have it until the provider
  // answers, and the row is written *before* the provider is called - see the
  // ordering note in PurchaseService.createQRIS.
  providerReference String? @unique
  bankReference     String? //reff id from bank

  providerName      String
  paymentMethodName String
  nominal           Decimal @default(0.0) @db.Decimal(15, 2) // Money
  netNominal        Decimal @default(0.0) @db.Decimal(15, 2) // Money

  status TransactionStatusEnum

  paidAt DateTime? @db.Timestamptz(6)
  // Nullable for the same reason as providerReference: the row exists before
  // the QR does, and a fabricated expiry would be a lie we then serve back.
  expiresAt DateTime? @db.Timestamptz(6)

  batchSettlementId     Int?
  settlementAt          DateTime? @db.Timestamptz(6)
  batchReconciliationId Int?
  reconciliationAt      DateTime? @db.Timestamptz(6)

  additionalInfo Json? @db.JsonB // Store NMID, RequestID, anything related to bank or custom upstream info
  metadata       Json? @db.JsonB // Store Response Upstream

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  createdBy Int?      @db.Integer()
  updatedAt DateTime? @db.Timestamptz(6)
  updatedBy Int?      @db.Integer()
  deletedAt DateTime? @db.Timestamptz(6)
  deletedBy Int?      @db.Integer()

  // Relasi
  feeDetails         PurchaseFeeDetail[]
  webhookLogs        WebhookLog[]
  MerchantBalanceLog MerchantBalanceLog[]
  AgentBalanceLog    AgentBalanceLog[]
  InternalBalanceLog InternalBalanceLog[]

  @@unique([merchantId, merchantReference])
  @@index([merchantId])
  @@index([providerName])
  @@index([status])
  @@schema("transaction")
}

model PurchaseFeeDetail {
  id         Int         @id @default(autoincrement())
  purchaseId Int
  agentId    Int?
  type       FeeTypeEnum

  nominal       Decimal @default(0.0) @db.Decimal(15, 2) // Money
  feeFixed      Decimal @default(0.0) @db.Decimal(15, 2) // Money
  feePercentage Decimal @default(0.0) @db.Decimal(8, 4) // Percentage

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  createdBy Int?      @db.Integer()
  updatedAt DateTime? @db.Timestamptz(6)
  updatedBy Int?      @db.Integer()
  deletedAt DateTime? @db.Timestamptz(6)
  deletedBy Int?      @db.Integer()

  // Relasi
  transaction PurchaseTransaction @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@schema("transaction")
}

model DisbursementTransaction {
  id         Int @id @default(autoincrement())
  merchantId Int

  systemReference   String  @unique // Our System Reference No
  merchantReference String  @unique // partnerReferenceNo (SNAP) - Transaction identifier on service provider system.
  providerReference String  @unique // referenceNo (SNAP) - Transaction identifier on service consumer system
  bankReference     String? //reff id from bank

  recipientName     String // bisa merchant, agent, atau pihak ketiga
  recipientAccount  String
  recipientBankCode String
  recipientBankName String?

  providerName      String
  paymentMethodName String
  nominal           Decimal @default(0.0) @db.Decimal(15, 2) // Money
  netNominal        Decimal @default(0.0) @db.Decimal(15, 2) // Money

  status TransactionStatusEnum

  paidAt DateTime? @db.Timestamptz(6)

  batchSettlementId     Int?
  settlementAt          DateTime? @db.Timestamptz(6)
  batchReconciliationId Int?
  reconciliationAt      DateTime? @db.Timestamptz(6)

  additionalInfo Json? @db.JsonB // Store NMID, RequestID, anything related to bank or custom upstream info
  metadata       Json? @db.JsonB // Store Response Upstream

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  createdBy Int?      @db.Integer()
  updatedAt DateTime? @db.Timestamptz(6)
  updatedBy Int?      @db.Integer()
  deletedAt DateTime? @db.Timestamptz(6)
  deletedBy Int?      @db.Integer()

  // Relasi
  feeDetails         DisbursementFeeDetail[]
  MerchantBalanceLog MerchantBalanceLog[]
  AgentBalanceLog    AgentBalanceLog[]
  InternalBalanceLog InternalBalanceLog[]

  @@index([providerName])
  @@index([status])
  @@schema("transaction")
}

model DisbursementFeeDetail {
  id             Int         @id @default(autoincrement())
  disbursementId Int
  agentId        Int?
  type           FeeTypeEnum

  nominal       Decimal @default(0.0) @db.Decimal(15, 2) // Money
  feeFixed      Decimal @default(0.0) @db.Decimal(15, 2) // Money
  feePercentage Decimal @default(0.0) @db.Decimal(8, 4) // Percentage

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  createdBy Int?      @db.Integer()
  updatedAt DateTime? @db.Timestamptz(6)
  updatedBy Int?      @db.Integer()
  deletedAt DateTime? @db.Timestamptz(6)
  deletedBy Int?      @db.Integer()

  disbursementTransaction DisbursementTransaction @relation(fields: [disbursementId], references: [id], onDelete: Cascade)

  @@index([disbursementId])
  @@schema("transaction")
}

model TopUpTransaction {
  id         Int @id @default(autoincrement())
  merchantId Int

  systemReference String @unique // Our System Reference No

  providerName      String
  paymentMethodName String
  nominal           Decimal @default(0.0) @db.Decimal(15, 2) // Money
  netNominal        Decimal @default(0.0) @db.Decimal(15, 2) // Money

  status       TransactionStatusEnum
  receiptImage String

  paidAt DateTime?

  settlementAt DateTime? @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  createdBy Int?      @db.Integer()
  updatedAt DateTime? @db.Timestamptz(6)
  updatedBy Int?      @db.Integer()
  deletedAt DateTime? @db.Timestamptz(6)
  deletedBy Int?      @db.Integer()

  merchantBalanceLog MerchantBalanceLog[]
  agentBalanceLog    AgentBalanceLog[]
  internalBalanceLog InternalBalanceLog[]
  feeDetails         TopupFeeDetail[]

  @@index([merchantId])
  @@schema("transaction")
}

model TopupFeeDetail {
  id      Int         @id @default(autoincrement())
  topupId Int
  agentId Int?
  type    FeeTypeEnum

  nominal       Decimal @default(0.0) @db.Decimal(15, 2) // Money
  feeFixed      Decimal @default(0.0) @db.Decimal(15, 2) // Money
  feePercentage Decimal @default(0.0) @db.Decimal(8, 4) // Percentage

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  createdBy Int?      @db.Integer()
  updatedAt DateTime? @db.Timestamptz(6)
  updatedBy Int?      @db.Integer()
  deletedAt DateTime? @db.Timestamptz(6)
  deletedBy Int?      @db.Integer()

  topUpTransation TopUpTransaction @relation(fields: [topupId], references: [id], onDelete: Cascade)

  @@index([topupId])
  @@schema("transaction")
}

/**
 * TRANSFER_BANK:
 * - Can transfered into bank account at profile
 * - Customize bank account number
 * TRANSFER_BANK Local Manual:
 * - Merchant fill the form
 * - Admin check the form
 * - Approve / Reject the form
 * - Transfer manually by admin thorugh Bank Account operational into recipient bank account
 * - Auto Settlement by the time admin approved
 * TRANSFER_BANK Local API
 * - Merchant fill the form
 * - Admin check the form
 * - Approve / Reject the form
 * - System hit Upstream API
 * - Auto settlement after waiting for webhook
 * ################################
 * USDT:
 * - Merchant fill the form
 * - Admin check the form
 * - Approve / Reject the form
 * - Admin must purchase USDT through Vendor
 * - Vendor send USDT to destination account USDT
 * - Auto Settlement by the time admin approved
 * USDT Manual
 * - Admin have the money to purchase USDT
 * USDT API
 * - Admin does not have money
 * - So must withdraw from upstream balance
 * - System hit Upstream Disbursement channel
 */
model WithdrawTransaction {
  id       Int    @id @default(autoincrement())
  userId   Int
  userRole String

  systemReference   String  @unique // Our System Reference No
  providerReference String? @unique // referenceNo (SNAP) - Transaction identifier on service consumer system
  bankReference     String? //reff id from bank

  providerName      String
  paymentMethodName String // TRANSFER_BANK or USDT
  nominal           Decimal @default(0.0) @db.Decimal(15, 2) // Money
  netNominal        Decimal @default(0.0) @db.Decimal(15, 2) // Money

  recipientName     String? // bisa merchant, agent, atau pihak ketiga
  recipientAccount  String?
  recipientBankCode String?
  recipientBankName String?

  status TransactionStatusEnum

  paidAt DateTime?

  settlementAt DateTime? @db.Timestamptz(6)

  additionalInfo Json? @db.JsonB // Store NMID, RequestID, anything related to bank or custom upstream info
  metadata       Json? @db.JsonB // Store Response Upstream

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  createdBy Int?      @db.Integer()
  updatedAt DateTime? @db.Timestamptz(6)
  updatedBy Int?      @db.Integer()
  deletedAt DateTime? @db.Timestamptz(6)
  deletedBy Int?      @db.Integer()

  // Relasi
  feeDetails         WithdrawFeeDetail[]
  MerchantBalanceLog MerchantBalanceLog[]
  AgentBalanceLog    AgentBalanceLog[]
  InternalBalanceLog InternalBalanceLog[]

  @@index([userId])
  @@index([status])
  @@schema("transaction")
}

model WithdrawFeeDetail {
  id         Int         @id @default(autoincrement())
  withdrawId Int
  agentId    Int?
  type       FeeTypeEnum

  nominal       Decimal @default(0.0) @db.Decimal(15, 2) // Money
  feeFixed      Decimal @default(0.0) @db.Decimal(15, 2) // Money
  feePercentage Decimal @default(0.0) @db.Decimal(8, 4) // Percentage

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  createdBy Int?      @db.Integer()
  updatedAt DateTime? @db.Timestamptz(6)
  updatedBy Int?      @db.Integer()
  deletedAt DateTime? @db.Timestamptz(6)
  deletedBy Int?      @db.Integer()

  withdrawTransaction WithdrawTransaction @relation(fields: [withdrawId], references: [id], onDelete: Cascade)

  @@index([withdrawId])
  @@schema("transaction")
}

model WebhookLog {
  id              Int                 @id @default(autoincrement())
  transactionId   Int
  source          String // e.g. midtrans, xendit
  payload         Json
  rawSignature    String?
  receivedAt      DateTime            @default(now())
  transactionType TransactionTypeEnum

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  createdBy Int?      @db.Integer()
  updatedAt DateTime? @db.Timestamptz(6)
  updatedBy Int?      @db.Integer()
  deletedAt DateTime? @db.Timestamptz(6)
  deletedBy Int?      @db.Integer()

  PurchaseTransaction   PurchaseTransaction? @relation(fields: [purchaseTransactionId], references: [id])
  purchaseTransactionId Int?

  @@index([source])
  @@schema("transaction")
}

model TransactionAudit {
  id              Int                   @id @default(autoincrement())
  transactionId   Int
  oldStatus       TransactionStatusEnum
  newStatus       TransactionStatusEnum
  source          String // "webhook", "admin", etc
  changedAt       DateTime              @default(now())
  transactionType TransactionTypeEnum

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  createdBy Int?      @db.Integer()
  updatedAt DateTime? @db.Timestamptz(6)
  updatedBy Int?      @db.Integer()
  deletedAt DateTime? @db.Timestamptz(6)
  deletedBy Int?      @db.Integer()

  @@index([transactionId])
  @@schema("transaction")
}

model MerchantBalanceLog {
  id         Int @id @default(autoincrement())
  merchantId Int

  topupId        Int?
  purchaseId     Int?
  withdrawId     Int?
  disbursementId Int?

  changeAmount   Decimal @default(0.0) @db.Decimal(15, 2) // Money // nominal perubahan (positif / negatif)
  balanceActive  Decimal @default(0.0) @db.Decimal(15, 2) // Money // saldo akhir merchant setelah perubahan
  balancePending Decimal @default(0.0) @db.Decimal(15, 2) // Money

  transactionType TransactionTypeEnum

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  createdBy Int?      @db.Integer()
  updatedAt DateTime? @db.Timestamptz(6)
  updatedBy Int?      @db.Integer()
  deletedAt DateTime? @db.Timestamptz(6)
  deletedBy Int?      @db.Integer()

  topupTransaction        TopUpTransaction?        @relation(fields: [topupId], references: [id], onDelete: SetNull)
  purchaseTransaction     PurchaseTransaction?     @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  withdrawTransaction     WithdrawTransaction?     @relation(fields: [withdrawId], references: [id], onDelete: SetNull)
  disbursementTransaction DisbursementTransaction? @relation(fields: [disbursementId], references: [id], onDelete: SetNull)

  @@index([merchantId])
  @@index([topupId])
  @@index([purchaseId])
  @@index([withdrawId])
  @@index([disbursementId])
  @@schema("transaction")
}

model AgentBalanceLog {
  id      Int @id @default(autoincrement())
  agentId Int

  topupId        Int?
  purchaseId     Int?
  withdrawId     Int?
  disbursementId Int?

  changeAmount   Decimal @default(0.0) @db.Decimal(15, 2) // Money // nominal perubahan (positif / negatif)
  balanceActive  Decimal @default(0.0) @db.Decimal(15, 2) // Money // saldo akhir merchant setelah perubahan
  balancePending Decimal @default(0.0) @db.Decimal(15, 2) // Money

  transactionType TransactionTypeEnum

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  createdBy Int?      @db.Integer()
  updatedAt DateTime? @db.Timestamptz(6)
  updatedBy Int?      @db.Integer()
  deletedAt DateTime? @db.Timestamptz(6)
  deletedBy Int?      @db.Integer()

  topupTransaction        TopUpTransaction?        @relation(fields: [topupId], references: [id], onDelete: SetNull)
  purchaseTransaction     PurchaseTransaction?     @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  withdrawTransaction     WithdrawTransaction?     @relation(fields: [withdrawId], references: [id], onDelete: SetNull)
  disbursementTransaction DisbursementTransaction? @relation(fields: [disbursementId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([topupId])
  @@index([purchaseId])
  @@index([withdrawId])
  @@index([disbursementId])
  @@schema("transaction")
}

model InternalBalanceLog {
  id Int @id @default(autoincrement())

  topupId        Int?
  purchaseId     Int?
  withdrawId     Int?
  disbursementId Int?
  merchantId     Int?

  changeAmount   Decimal @default(0.0) @db.Decimal(15, 2) // Money // nominal perubahan (positif / negatif)
  balanceActive  Decimal @default(0.0) @db.Decimal(15, 2) // Money // saldo akhir merchant setelah perubahan
  balancePending Decimal @default(0.0) @db.Decimal(15, 2) // Money

  transactionType TransactionTypeEnum

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  createdBy Int?      @db.Integer()
  updatedAt DateTime? @db.Timestamptz(6)
  updatedBy Int?      @db.Integer()
  deletedAt DateTime? @db.Timestamptz(6)
  deletedBy Int?      @db.Integer()

  topupTransaction        TopUpTransaction?        @relation(fields: [topupId], references: [id], onDelete: SetNull)
  purchaseTransaction     PurchaseTransaction?     @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  withdrawTransaction     WithdrawTransaction?     @relation(fields: [withdrawId], references: [id], onDelete: SetNull)
  disbursementTransaction DisbursementTransaction? @relation(fields: [disbursementId], references: [id], onDelete: SetNull)

  @@index([topupId])
  @@index([purchaseId])
  @@index([withdrawId])
  @@index([disbursementId])
  @@schema("transaction")
}

enum TransactionStatusEnum {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  CANCELLED

  @@schema("transaction")
}

enum FeeTypeEnum {
  AGENT
  INTERNAL
  PROVIDER
  MERCHANT

  @@schema("transaction")
}

enum TransactionTypeEnum {
  WITHDRAW
  TOPUP
  DISBURSEMENT
  PURCHASE
  SETTLEMENT_PURCHASE

  @@schema("transaction")
}
