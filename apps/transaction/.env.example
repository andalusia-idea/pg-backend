# Application
APP_NAME=TRANSACTION
NODE_ENV=development
PORT=3003
VERSION=v1
TIMEZONE="Asia/Jakarta"
CORS_ORIGINS=http://localhost:3000/;https://api.example.com

# Database PostgreSQL
POSTGRESQL_URL_MASTER="postgresql://postgres:12345678@localhost:5432/pg?TimeZone=Asia/Jakarta&schema=transaction"
POSTGRESQL_URL_SLAVE="postgresql://postgres:12345678@localhost:5432/pg?TimeZone=Asia/Jakarta&schema=transaction"

# TCP Auth
CLIENT_AUTH_NAME="AUTH_SERVICE"
CLIENT_AUTH_HOST="127.0.0.1"
CLIENT_AUTH_PORT=4001

# TCP Config
CLIENT_CONFIG_NAME="CONFIG_SERVICE"
CLIENT_CONFIG_HOST="127.0.0.1"
CLIENT_CONFIG_PORT=4002

# TCP Transaction
CLIENT_TRANSACTION_NAME="TRANSACTION_SERVICE"
CLIENT_TRANSACTION_HOST="127.0.0.1"
CLIENT_TRANSACTION_PORT=4003

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=redis
REDIS_PASSWORD=12345678

## UPSTREAM: MOTIONPAY (Flash Mobile) QRIS
# Use .id — their docs also mention .co.id, but that domain does not resolve.
# See docs/upstream/motionpay.md
MOTIONPAY_BASE_URL="https://sandbox-app.flashmobile.id"
MOTIONPAY_CLIENT_KEY=""
MOTIONPAY_SERVER_KEY=""
# Optional, defaults shown
MOTIONPAY_TIMEOUT_MS=15000
MOTIONPAY_TOKEN_SKEW_SECONDS=300

## UPSTREAM: MOTIONPAY TRANSFER (payout)
# Different product from QRIS: different host (secure. not app.), different
# token endpoint, and a different response envelope. Requires your public IP
# to be whitelisted by Flash before any call succeeds.
MOTIONPAY_TRANSFER_BASE_URL="https://sandbox-secure.flashmobile.id"
# Optional - fall back to MOTIONPAY_CLIENT_KEY / MOTIONPAY_SERVER_KEY when unset.
# Set them only if Flash issued a separate credential pair for Transfer.
MOTIONPAY_TRANSFER_CLIENT_KEY=""
MOTIONPAY_TRANSFER_SERVER_KEY=""

