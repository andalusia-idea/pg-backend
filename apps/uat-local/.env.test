# Application
APP_NAME=UAT-LOCAL
NODE_ENV=test
PORT=3010
VERSION=v1
TIMEZONE="Asia/Jakarta"
CORS_ORIGINS=http://localhost:3000/;https://api.example.com
TRUST_PROXY=

# Where the harness points its own calls. The dashboard carries the /api/v1
# prefix; transaction sets none.
DASHBOARD_BASE_URL=http://localhost:3000
TRANSACTION_BASE_URL=http://localhost:3003

# Database PostgreSQL
POSTGRESQL_URL_MASTER_AUTH="postgresql://postgres:12345678@localhost:5432/pgtest?TimeZone=Asia/Jakarta&schema=auth"
POSTGRESQL_URL_SLAVE_AUTH="postgresql://postgres:12345678@localhost:5432/pgtest?TimeZone=Asia/Jakarta&schema=auth"
POSTGRESQL_URL_MASTER_CONFIG="postgresql://postgres:12345678@localhost:5432/pgtest?TimeZone=Asia/Jakarta&schema=config"
POSTGRESQL_URL_SLAVE_CONFIG="postgresql://postgres:12345678@localhost:5432/pgtest?TimeZone=Asia/Jakarta&schema=config"
POSTGRESQL_URL_MASTER_TRANSACTION="postgresql://postgres:12345678@localhost:5432/pgtest?TimeZone=Asia/Jakarta&schema=transaction"
POSTGRESQL_URL_SLAVE_TRANSACTION="postgresql://postgres:12345678@localhost:5432/pgtest?TimeZone=Asia/Jakarta&schema=transaction"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=redis
REDIS_PASSWORD=12345678

# Which seeded merchant the harness acts as. Credentials are read from
# auth.MerchantSignature at use time, not stored here - inject step 07 rotates
# the secret, so a copy would be correct until the first rotation.
UAT_MERCHANT_EMAIL=merchant1@example.com

# How much traffic the merchant crons generate. Zero is off, which is why
# there is no separate enable flag.
#
# The disbursement rate is 0 deliberately: merchant1's TRANSFERBANK rail
# resolves to JATELINDO, and JATELINDO_TRANSFER_BASE_URL still points at the
# provider's real dev host. Raising this before Step 8c repoints that key would
# send unattended payout requests to someone else's service.
UAT_PURCHASE_PER_MINUTE=6
UAT_DISBURSEMENT_PER_MINUTE=0

# The random amount each purchase carries. Note scenarioFor keys on the last
# two digits, so this range is also what feeds the switchboard - while the
# switchboard is off the cron keeps the last two digits inside the SUCCESS
# band, and only opens up to the full range when it is on.
UAT_AMOUNT_MIN=10000
UAT_AMOUNT_MAX=500000

# The scenario switchboard, for the callback dispatcher.
#
# False delivers only the SUCCESS band, which is build-order Step 6 - one clean
# settlement before the other nine scenarios are let loose. Step 9 flips this
# to true and walks the bands. It gates delivery, not creation: scenarioFor
# still assigns every band at create time, so a held transaction logs that it
# is held rather than quietly passing as a success.
#
# Anything but the literal "true" is false, so a typo holds at Step 6.
UAT_SWITCHBOARD_ENABLED=false

# The empty-array probe for the Jatelindo fake, which is build-order Step 8d.
#
# True makes an accepted single transfer answer A01 with an empty
# DisbursementResponse - permitted by the schema, read at [0] without a
# non-empty check. Point it at one request deliberately; it is not a mood the
# provider is ever in, which is why it is not a scenario band.
UAT_JATELINDO_EMPTY_DISBURSEMENT=false
