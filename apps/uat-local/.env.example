# Application
APP_NAME=UAT-LOCAL
NODE_ENV=development
PORT=3010
VERSION=v1
TIMEZONE="Asia/Jakarta"
CORS_ORIGINS=http://localhost:3000/;https://api.example.com
TRUST_PROXY=

# Where the harness points its own calls. The dashboard carries the /api/v1
# prefix; transaction sets none.
DASHBOARD_BASE_URL=http://localhost:3000
TRANSACTION_BASE_URL=http://localhost:3003

# Database PostgreSQL
POSTGRESQL_URL_MASTER_AUTH="postgresql://postgres:12345678@localhost:5432/pg?TimeZone=Asia/Jakarta&schema=auth"
POSTGRESQL_URL_SLAVE_AUTH="postgresql://postgres:12345678@localhost:5432/pg?TimeZone=Asia/Jakarta&schema=auth"
POSTGRESQL_URL_MASTER_CONFIG="postgresql://postgres:12345678@localhost:5432/pg?TimeZone=Asia/Jakarta&schema=config"
POSTGRESQL_URL_SLAVE_CONFIG="postgresql://postgres:12345678@localhost:5432/pg?TimeZone=Asia/Jakarta&schema=config"
POSTGRESQL_URL_MASTER_TRANSACTION="postgresql://postgres:12345678@localhost:5432/pg?TimeZone=Asia/Jakarta&schema=transaction"
POSTGRESQL_URL_SLAVE_TRANSACTION="postgresql://postgres:12345678@localhost:5432/pg?TimeZone=Asia/Jakarta&schema=transaction"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=redis
REDIS_PASSWORD=12345678
