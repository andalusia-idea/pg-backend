model DisbursementTransaction {
  id         Int @id @default(autoincrement())
  merchantId Int

  // Our reference, and for Transfer it is also the key the provider's status
  // endpoint is queried by - unlike QRIS, which is keyed by *their* id. That
  // makes global uniqueness load-bearing here, not just tidy.
  systemReference   String  @unique
  // partnerReferenceNo (SNAP). Unique PER MERCHANT, not globally: merchants
  // number their own payouts, so a global unique would let the first merchant
  // to use "PAYOUT-001" block every other merchant from that string.
  merchantReference String
  // referenceNo (SNAP). Nullable because we do not have it until the provider
  // answers, and the row is written *before* the provider is called.
  providerReference String? @unique
  bankReference     String? //reff id from bank

  /// Where the money goes. Named to match `auth.MerchantDetail` /
  /// `auth.AgentDetail` and `config.Bank.code`, which is where these values are
  /// copied from.
  ///
  /// `bankCode` is **polymorphic, and deliberately not a foreign key**: it holds
  /// a `config.Bank.code` when `paymentMethodName` is TRANSFERBANK, and an
  /// `EWalletEnum` value (OVO / DANA / GOPAY / SHOPEEPAY) when it is
  /// TRANSFEREWALLET. `accountNumber` likewise holds a wallet phone number in
  /// the e-wallet case.
  ///
  /// So check `paymentMethodName` before joining on either. A bare
  /// `JOIN config."Bank" ON code = "bankCode"` silently drops every e-wallet
  /// payout instead of failing - there is no constraint to catch it, since the
  /// two tables live in different Postgres schemas.
  ///
  /// The bank's *name* is not stored: it is derivable from `bankCode`, and a
  /// stored copy goes stale when a bank is renamed.
  accountHolderName String // bisa merchant, agent, atau pihak ketiga
  accountNumber     String
  bankCode          String

  providerName      String
  paymentMethodName String
  nominal           Decimal @default(0.0) @db.Decimal(15, 2) // Money
  netNominal        Decimal @default(0.0) @db.Decimal(15, 2) // Money

  status TransactionStatusEnum

  paidAt DateTime? @db.Timestamptz(6)

  batchSettlementId Int?
  settlementAt      DateTime? @db.Timestamptz(6)

  additionalInfo Json? @db.JsonB // Store NMID, RequestID, anything related to bank or custom upstream info
  metadata       Json? @db.JsonB // Store Response Upstream

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  createdBy Int?      @db.Integer()
  updatedAt DateTime? @db.Timestamptz(6)
  updatedBy Int?      @db.Integer()
  deletedAt DateTime? @db.Timestamptz(6)
  deletedBy Int?      @db.Integer()

  // Relasi
  feeDetails DisbursementFeeDetail[]

  @@unique([merchantId, merchantReference])
  @@index([merchantId])
  @@index([providerName])
  @@index([status])
  @@schema("transaction")
}

