model PurchaseTransaction {
  id         Int @id @default(autoincrement())
  merchantId Int

  systemReference   String  @unique // Our System Reference No
  // partnerReferenceNo (SNAP). Unique PER MERCHANT, not globally: merchants
  // number their own orders, so a global unique would let the first merchant to
  // use "ORDER-001" permanently block every other merchant from that string.
  merchantReference String
  // referenceNo (SNAP). Nullable because we do not have it until the provider
  // answers, and the row is written *before* the provider is called - see the
  // ordering note in PurchaseService.createQRIS.
  providerReference String? @unique
  bankReference     String? //reff id from bank

  providerName      String
  paymentMethodName String
  nominal           Decimal @default(0.0) @db.Decimal(15, 2) // Money
  netNominal        Decimal @default(0.0) @db.Decimal(15, 2) // Money

  status TransactionStatusEnum

  paidAt    DateTime? @db.Timestamptz(6)
  // Nullable for the same reason as providerReference: the row exists before
  // the QR does, and a fabricated expiry would be a lie we then serve back.
  expiresAt DateTime? @db.Timestamptz(6)

  // settlement.SettlementBatch.id, but a plain Int rather than a relation: the
  // claim in apps/settlement selects on `IS NULL` and never traverses the link,
  // and the dashboard reads a batch's rows by this same column. The cost is
  // that nothing stops a batch row being deleted out from under these, which is
  // acceptable only because batches are append-only records. Kept consistent
  // with batchReconciliationId below, which has no table behind it yet.
  batchSettlementId Int?
  settlementAt      DateTime? @db.Timestamptz(6)

  additionalInfo Json? @db.JsonB // Store NMID, RequestID, anything related to bank or custom upstream info
  metadata       Json? @db.JsonB // Store Response Upstream

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  createdBy Int?      @db.Integer()
  updatedAt DateTime? @db.Timestamptz(6)
  updatedBy Int?      @db.Integer()
  deletedAt DateTime? @db.Timestamptz(6)
  deletedBy Int?      @db.Integer()

  // Relasi
  feeDetails PurchaseFeeDetail[]

  @@unique([merchantId, merchantReference])
  @@index([merchantId])
  @@index([providerName])
  @@index([status])
  @@schema("transaction")
}

