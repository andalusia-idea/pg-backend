# Application
APP_NAME=DASHBOARD
NODE_ENV=development
PORT=3000
VERSION=v1
TIMEZONE="Asia/Jakarta"
CORS_ORIGINS=http://localhost:3000/;https://api.example.com

# Must match the auth service's secret - the dashboard verifies tokens that
# service issues. Expiry values are in seconds.
JWT_ACCESS_TOKEN_SECRET=change-me
JWT_ACCESS_TOKEN_EXPIRE=43200
JWT_REFRESH_TOKEN_SECRET=change-me
JWT_REFRESH_TOKEN_EXPIRE=86400

# Database PostgreSQL
POSTGRESQL_URL_MASTER="postgresql://postgres:12345678@localhost:5432/pg?TimeZone=Asia/Jakarta"
POSTGRESQL_URL_SLAVE="postgresql://postgres:12345678@localhost:5432/pg?TimeZone=Asia/Jakarta"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=redis
REDIS_PASSWORD=12345678

# Redis Auth
MERCHANT_SIGNATURE_TIMESTAMP_TOLERANCE_SECONDS=300
MERCHANT_SIGNATURE_NONCE_TTL_SECONDS=600
MERCHANT_SIGNATURE_SECRET_KEY_GRACE_SECONDS=86400
MERCHANT_SIGNATURE_CACHE_TTL_SECONDS=60
MERCHANT_SIGNATURE_RATE_LIMIT_MAX_REQUESTS=120
MERCHANT_SIGNATURE_RATE_LIMIT_WINDOW_SECONDS=60

# Redis Config
BASE_FEE_TTL_SECONDS=21600
MERCHANT_FEE_TTL_SECONDS=21600
AGENT_SHAREHOLDER_TTL_SECONDS=21600


