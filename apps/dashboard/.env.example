APP_NAME=DASHBOARD

NODE_ENV=development
PORT=3000
VERSION=v1

TIMEZONE="Asia/Jakarta"

CORS_ORIGINS=http://localhost:3000/;https://api.example.com

POSTGRESQL_URL_MASTER="postgresql://postgres:12345678@localhost:5432/pg?TimeZone=Asia/Jakarta"
POSTGRESQL_URL_SLAVE="postgresql://postgres:12345678@localhost:5432/pg?TimeZone=Asia/Jakarta"

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=redis
REDIS_PASSWORD=12345678

# Must match the auth service's secret - the dashboard verifies tokens that
# service issues. Expiry values are in seconds.
JWT_ACCESS_TOKEN_SECRET=change-me
JWT_ACCESS_TOKEN_EXPIRE=43200
JWT_REFRESH_TOKEN_SECRET=change-me
JWT_REFRESH_TOKEN_EXPIRE=86400
