{
  "name": "pg",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "kill-port": "node scripts/kill-port.js",
    "start:dev:all": "node scripts/start-dev-all.js",
    "start:dashboard": "nest start dashboard --watch",
    "start:auth": "nest start auth --watch",
    "start:config": "nest start config --watch",
    "start:transaction": "nest start transaction --watch",
    "build:dashboard": "nest build dashboard",
    "build:auth": "nest build auth",
    "build:config": "nest build config",
    "build:transaction": "nest build transaction",
    "prisma:merge:dashboard": "node apps/dashboard/prisma/merge-schema.js",
    "prisma:generate:dashboard": "dotenv -e apps/dashboard/.env.local -- prisma generate --config apps/dashboard/prisma.config.ts",
    "prisma:generate:auth": "dotenv -e apps/auth/.env.local -- prisma generate --config apps/auth/prisma.config.ts",
    "prisma:generate:config": "dotenv -e apps/config/.env.local -- prisma generate --config apps/config/prisma.config.ts",
    "prisma:generate:transaction": "dotenv -e apps/transaction/.env.local -- prisma generate --config apps/transaction/prisma.config.ts",
    "prisma:migrate:dev:auth": "dotenv -e apps/auth/.env.local -- prisma migrate dev --config apps/auth/prisma.config.ts",
    "prisma:migrate:dev:config": "dotenv -e apps/config/.env.local -- prisma migrate dev --config apps/config/prisma.config.ts",
    "prisma:migrate:dev:transaction": "dotenv -e apps/transaction/.env.local -- prisma migrate dev --config apps/transaction/prisma.config.ts",
    "prisma:migrate:deploy:auth": "dotenv -e apps/auth/.env.local -- prisma migrate deploy --config apps/auth/prisma.config.ts",
    "prisma:migrate:deploy:config": "dotenv -e apps/config/.env.local -- prisma migrate deploy --config apps/config/prisma.config.ts",
    "prisma:migrate:deploy:transaction": "dotenv -e apps/transaction/.env.local -- prisma migrate deploy --config apps/transaction/prisma.config.ts",
    "prisma:seed:auth": "dotenv -e apps/auth/.env.local -- prisma db seed --config apps/auth/prisma.config.ts --",
    "prisma:seed:auth:dev": "dotenv -e apps/auth/.env.local -- prisma db seed --config apps/auth/prisma.config.ts -- --dev",
    "prisma:seed:config": "dotenv -e apps/config/.env.local -- prisma db seed --config apps/config/prisma.config.ts --",
    "prisma:seed:config:dev": "dotenv -e apps/config/.env.local -- prisma db seed --config apps/config/prisma.config.ts -- --dev",
    "prisma:migrate:reset:auth": "dotenv -e apps/auth/.env.local -- prisma migrate reset --config apps/auth/prisma.config.ts",
    "prisma:migrate:reset:config": "dotenv -e apps/config/.env.local -- prisma migrate reset --config apps/config/prisma.config.ts",
    "prisma:migrate:status:auth": "dotenv -e apps/auth/.env.local -- prisma migrate status --config apps/auth/prisma.config.ts",
    "prisma:migrate:status:config": "dotenv -e apps/config/.env.local -- prisma migrate status --config apps/config/prisma.config.ts",
    "prisma:migrate:status:transaction": "dotenv -e apps/transaction/.env.local -- prisma migrate status --config apps/transaction/prisma.config.ts",
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/pg/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/pg/test/jest-e2e.json"
  },
  "dependencies": {
    "@fastify/static": "^9.3.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.28",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.1.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sinclair/typebox": "^0.34.52",
    "ajv": "^8.20.0",
    "argon2": "^0.44.0",
    "axios": "^1.18.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "ioredis": "^5.11.1",
    "luxon": "^3.7.2",
    "nestjs-cls": "^6.2.1",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.22.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.2",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/configuration(|/.*)$": "<rootDir>/libs/configuration/src/$1",
      "^@app/health(|/.*)$": "<rootDir>/libs/health/src/$1",
      "^@app/logger(|/.*)$": "<rootDir>/libs/logger/src/$1",
      "^@app/microservice(|/.*)$": "<rootDir>/libs/microservice/src/$1",
      "^@app/prisma(|/.*)$": "<rootDir>/libs/prisma/src/$1",
      "^@app/redis(|/.*)$": "<rootDir>/libs/redis/src/$1",
      "^@app/upstream(|/.*)$": "<rootDir>/libs/upstream/src/$1"
    }
  }
}
